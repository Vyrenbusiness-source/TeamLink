# TeamLink Sync-Server – Umgebungsvariablen
# Kopiere diese Datei als .env und passe die Werte an.
# .env wird NIEMALS ins Repository eingecheckt (→ .gitignore).

# HTTP/WebSocket-Port des Servers (Standard: 3000)
PORT=3000

# Pfad zur SQLite-Datenbankdatei, relativ zum Arbeitsverzeichnis.
# Das Verzeichnis wird beim Start automatisch angelegt, falls es fehlt.
# Standard: data/teamlink.db
DB_PATH=data/teamlink.db

# Node-Umgebung: development | production | test
# Im production-Modus werden Debug-Ausgaben unterdrückt.
NODE_ENV=production

# Geheimschlüssel für Session-Cookies (mind. 32 zufällige Zeichen, NIEMALS Standardwert in Produktion lassen)
SESSION_SECRET=ersetze-mich-mit-einem-sicheren-zufallswert

# Komma-separierte Liste erlaubter CORS-Origins (Standard: http://localhost in dev)
# Beispiel: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=
