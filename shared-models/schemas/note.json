{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "note",
  "type": "object",
  "required": ["id", "project_id", "content"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string" },
    "content": { "type": "string" },
    "updated_at": { "type": "integer" },
    "updated_by": { "type": ["string", "null"] }
  }
}
