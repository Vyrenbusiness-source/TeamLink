{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "membership",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "user_id", "project_id", "role", "joined_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid", "description": "Synthetic record id for sync" },
    "user_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "role": { "type": "string", "enum": ["lead", "member", "observer"] },
    "invited_by": {
      "type": ["string", "null"],
      "format": "uuid",
      "description": "User id who sent the invitation — audit log"
    },
    "joined_at": { "type": "integer", "description": "Unix ms timestamp" },
    "updated_at": { "type": "integer", "description": "Unix ms timestamp — LWW conflict resolution for role changes" }
  }
}
