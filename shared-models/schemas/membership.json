{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "membership",
  "type": "object",
  "required": ["user_id", "project_id", "role"],
  "properties": {
    "user_id": { "type": "string" },
    "project_id": { "type": "string" },
    "role": { "type": "string", "enum": ["lead", "member", "observer"] }
  }
}
