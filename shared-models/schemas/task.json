{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project_id", "title", "status", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["open", "taken", "done"] },
    "priority": { "type": ["string", "null"], "enum": ["low", "medium", "high", "urgent", null] },
    "assignee_id": { "type": ["string", "null"], "format": "uuid" },
    "deadline": { "type": ["integer", "null"], "description": "Unix ms timestamp" },
    "updated_by": { "type": ["string", "null"], "format": "uuid", "description": "User id of last editor — audit log" },
    "created_at": { "type": "integer", "description": "Unix ms timestamp" },
    "updated_at": { "type": "integer", "description": "Unix ms timestamp — LWW conflict resolution" }
  }
}
